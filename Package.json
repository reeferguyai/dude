  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:https": "vite --host 0.0.0.0 --port 5173 --https",
    "dev:xr": "vite --host 0.0.0.0 --port 5173 --https --open /?mode=xr",
    "dev:ollama": "OLLAMA_ORIGINS=* ollama serve",
    "build": "tsc -b && vite build",
    "build:gh-pages": "tsc -b && vite build --base=/",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:https": "vite preview --host 0.0.0.0 --port 4173 --https",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{json,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{json,html,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "3dpod:validate-stl": "node scripts/validate-3dpod-meshes.mjs",
    "pod:sync-catalog": "node scripts/sync-pod-catalog.mjs",
    "ai:build-rag-index": "node scripts/build-local-rag-index.mjs",
    "seo:validate": "node scripts/validate-seo-aeo.mjs",
    "seo:generate-sitemap": "node scripts/generate-sitemap.mjs",
    "audit:pwa": "lighthouse http://localhost:4173 --only-categories=performance,accessibility,best-practices,seo,pwa --output=json --output-path=./lighthouse-report.json",
    "audit:deps": "npm audit --audit-level=moderate",
    "clean": "rimraf dist coverage .vite"
  },
